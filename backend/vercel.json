{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js",
      "headers": {
        "cache-control": "s-maxage=1, stale-while-revalidate",
        "access-control-allow-origin": "*"
      }
    }
  ]
}
